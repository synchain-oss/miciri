# thresholds.json 转 C++ 常量头文件。构建时由 cmake/MiciriThresholds.cmake 在配置期调用；也能单独跑（测试用它确认坏输入会被拒）：
#   cmake -DINPUT=thresholds.json -DSCHEMA=tools/thresholds-schema.json -DOUTPUT=<头文件> -P tools/gen-thresholds.cmake
# 校验口径的真源是 schema：必填字段、允许的字段、state 的取值都从 schema 读，这里不再重复一份。
# 生成物是 miciri::thr::<组>::<名字>：数值一律 double，布尔是 bool，数值数组是 std::array<double, N>。value 为 null
# （还没有值，待标定）的项不生成：代码引用它会编译失败，而不是静默用一个猜出来的数。

function(_thr_fail path msg)
  message(FATAL_ERROR "thresholds: ${path}: ${msg}")
endfunction()

# 把 JSON 的数字文本变成 C++ 的 double 字面量：整数补 .0
function(_thr_literal out text)
  if(NOT "${text}" MATCHES "[.eE]")
    set(text "${text}.0")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# schema 里 definitions.entry 下某个数组读成 CMake 列表
function(_thr_schema_list out sdoc)
  string(JSON n LENGTH "${sdoc}" ${ARGN})
  set(items "")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON item GET "${sdoc}" ${ARGN} ${i})
    list(APPEND items "${item}")
  endforeach()
  set(${out} "${items}" PARENT_SCOPE)
endfunction()

function(miciri_generate_thresholds input schema output)
  file(READ "${schema}" sdoc)
  file(READ "${input}" doc)
  _thr_schema_list(required "${sdoc}" definitions entry required)
  _thr_schema_list(states "${sdoc}" definitions entry properties state enum)
  string(JSON props GET "${sdoc}" definitions entry properties)
  string(JSON pn LENGTH "${props}")
  set(allowed "")
  math(EXPR plast "${pn} - 1")
  foreach(i RANGE ${plast})
    string(JSON p MEMBER "${props}" ${i})
    list(APPEND allowed "${p}")
  endforeach()

  string(JSON ver ERROR_VARIABLE err GET "${doc}" schema_version)
  if(NOT "${ver}" STREQUAL "1")
    _thr_fail("schema_version" "must be 1")
  endif()

  set(body "")
  string(JSON n LENGTH "${doc}")
  math(EXPR last "${n} - 1")
  foreach(gi RANGE ${last})
    string(JSON group MEMBER "${doc}" ${gi})
    if(group STREQUAL "schema_version")
      continue()
    endif()
    if(NOT group MATCHES "^[a-z][a-z0-9_]*$")
      _thr_fail("${group}" "bad group name (lower snake case)")
    endif()
    string(JSON gdoc GET "${doc}" "${group}")
    string(JSON gn LENGTH "${gdoc}")
    if(gn EQUAL 0)
      _thr_fail("${group}" "empty group")
    endif()
    string(APPEND body "namespace ${group} {\n")
    math(EXPR glast "${gn} - 1")
    foreach(ki RANGE ${glast})
      string(JSON key MEMBER "${gdoc}" ${ki})
      set(path "${group}.${key}")
      if(NOT key MATCHES "^[a-z][a-z0-9_]*$")
        _thr_fail("${path}" "bad key name (lower snake case)")
      endif()
      string(JSON e GET "${gdoc}" "${key}")
      string(JSON en LENGTH "${e}")
      foreach(f IN LISTS required)
        string(JSON t ERROR_VARIABLE err TYPE "${e}" "${f}")
        if(NOT "${err}" STREQUAL "NOTFOUND")
          _thr_fail("${path}" "missing field ${f}")
        endif()
      endforeach()
      math(EXPR elast "${en} - 1")
      foreach(mi RANGE ${elast})
        string(JSON m MEMBER "${e}" ${mi})
        if(NOT m IN_LIST allowed)
          _thr_fail("${path}" "unknown field ${m}")
        endif()
      endforeach()

      string(JSON state GET "${e}" state)
      if(NOT state IN_LIST states)
        _thr_fail("${path}" "state ${state} is not in the schema enum (${states})")
      endif()
      string(JSON stype TYPE "${e}" source)
      string(JSON source GET "${e}" source)
      if(NOT stype STREQUAL "STRING" OR source STREQUAL "")
        _thr_fail("${path}" "source must be a non-empty string")
      endif()
      string(JSON dtype TYPE "${e}" date)
      if(state STREQUAL "synthetic")
        string(JSON date GET "${e}" date)
        if(NOT dtype STREQUAL "STRING" OR NOT date MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$")
          _thr_fail("${path}" "synthetic entry needs a date (YYYY-MM-DD)")
        endif()
      elseif(NOT dtype STREQUAL "NULL")
        _thr_fail("${path}" "pending entry must have date null")
      endif()

      string(JSON vtype TYPE "${e}" value)
      if(vtype STREQUAL "NULL")
        if(NOT state STREQUAL "pending")
          _thr_fail("${path}" "null value is only allowed while pending")
        endif()
        string(APPEND body "// ${key}: no value yet\n")
      elseif(vtype STREQUAL "NUMBER")
        string(JSON v GET "${e}" value)
        _thr_literal(lit "${v}")
        string(APPEND body "inline constexpr double ${key} = ${lit};\n")
      elseif(vtype STREQUAL "BOOLEAN")
        string(JSON v GET "${e}" value)
        if(v)
          string(APPEND body "inline constexpr bool ${key} = true;\n")
        else()
          string(APPEND body "inline constexpr bool ${key} = false;\n")
        endif()
      elseif(vtype STREQUAL "ARRAY")
        string(JSON an LENGTH "${e}" value)
        if(an EQUAL 0)
          _thr_fail("${path}" "empty array")
        endif()
        set(lits "")
        math(EXPR alast "${an} - 1")
        foreach(ai RANGE ${alast})
          string(JSON at TYPE "${e}" value ${ai})
          if(NOT at STREQUAL "NUMBER")
            _thr_fail("${path}" "array elements must be numbers")
          endif()
          string(JSON v GET "${e}" value ${ai})
          _thr_literal(lit "${v}")
          list(APPEND lits "${lit}")
        endforeach()
        list(JOIN lits ", " joined)
        string(APPEND body "inline constexpr std::array<double, ${an}> ${key} = {${joined}};\n")
      else()
        _thr_fail("${path}" "value must be a number, boolean, array of numbers or null (got ${vtype})")
      endif()
    endforeach()
    string(APPEND body "} // namespace ${group}\n\n")
  endforeach()

  set(content "// Generated by tools/gen-thresholds.cmake from thresholds.json. Do not edit.\n#pragma once\n\n#include <array>\n\nnamespace miciri::thr {\n\n${body}} // namespace miciri::thr\n")
  set(old "")
  if(EXISTS "${output}")
    file(READ "${output}" old)
  endif()
  if(NOT old STREQUAL content)
    file(WRITE "${output}" "${content}")
  endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  miciri_generate_thresholds("${INPUT}" "${SCHEMA}" "${OUTPUT}")
endif()
